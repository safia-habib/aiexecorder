# Copy this file to .env and adjust values for local dev.
# docker-compose sets these automatically; only needed when running the backend directly.

OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=state_eo
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b

# Leave empty to disable OpenTelemetry export (safe for local dev)
OTLP_ENDPOINT=
