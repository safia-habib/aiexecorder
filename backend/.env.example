# Copy this file to .env and adjust values for local dev.
# docker-compose sets these automatically; only needed when running the backend directly.

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=state_eo

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# Used for both embeddings (text-embedding-3-small) and chat completions (gpt-4o).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── OpenTelemetry / OpenInference tracing ────────────────────────────────────
# Leave OTLP_ENDPOINT empty to disable all telemetry export (safe for local dev).
# All three vars must be set to enable export.

# OTLP collector / platform endpoint (gRPC, no trailing slash)
OTLP_ENDPOINT=

# Authentication headers — comma-separated key=value pairs.
# Dynatrace example:
#   OTLP_HEADERS=Authorization=Api-Token dt0c01.XXXXXXXXXXXX
# Arize Phoenix example:
#   OTLP_HEADERS=api_key=<your-api-key>,space_id=<your-space-id>
# Generic Bearer token:
#   OTLP_HEADERS=Authorization=Bearer <token>
OTLP_HEADERS=

# Service name shown in your APM/tracing UI
OTLP_SERVICE_NAME=state-ai-eo-explorer
